# Настройки Apache для zptk.ru (хостинг REG.RU).
# Перенаправление на HTTPS и с www включается в панели хостинга вместе с SSL-сертификатом.

AddDefaultCharset utf-8
DirectoryIndex index.html
Options -Indexes
ErrorDocument 404 /404.html

# Старые адреса сайта на WordPress (ещё в поиске) ведут на новые страницы
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(услуги|uslugi)/?$ /uslugi.html [R=301,L,NC]
  RewriteRule ^(деятельность-в-ит|деятельность-в-it|deyatelnost-v-it|it)/?$ /it.html [R=301,L,NC]
  RewriteRule ^(наши-проекты|проекты|nashi-proekty|proekty)/?$ /proekty.html [R=301,L,NC]
  RewriteRule ^(контактные-данные|контакты|kontaktnye-dannye|kontakty)/?$ /kontakty.html [R=301,L,NC]
  RewriteRule ^(о-компании|о-нас|o-kompanii|o-nas|about)/?$ /o-kompanii.html [R=301,L,NC]
  RewriteRule ^(политика-конфиденциальности|privacy-policy|politika)/?$ /politika.html [R=301,L,NC]
  RewriteRule ^napravleniya/?$ /napravleniya.html [R=301,L]
  # Прочие страницы и служебные адреса WordPress ведут на главную
  RewriteCond %{QUERY_STRING} (^|&)(p|page_id|cat)=\d+ [NC]
  RewriteRule ^(index\.php)?$ /? [R=301,L]
  RewriteRule ^(wp-[^/]+|feed|category|tag|author)(/.*)?$ / [R=301,L,NC]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^[^.]+/$ / [R=301,L]
</IfModule>

AddType font/woff2 .woff2
AddType image/webp .webp

# Служебные файлы не отдаём
<FilesMatch "(^\.|\.(md|py|js\.map|sh|bak|log)$)">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/pdf "access plus 1 day"
</IfModule>
